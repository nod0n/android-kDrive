<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.infomaniak.drive" />
    </queries>
    <!-- AGP fills the first instrumentation element from its standard test configuration. -->
    <instrumentation
        android:name="androidx.test.runner.AndroidJUnitRunner"
        android:targetPackage="com.infomaniak.drive" />
    <!-- This separate debug entry targets the empty test application, never the real app. -->
    <instrumentation
        android:name="com.infomaniak.drive.data.cache.copyreader.OfflineCopyInstrumentation"
        android:targetPackage="com.infomaniak.drive.test"
        android:functionalTest="false"
        android:handleProfiling="false" />
    <!-- Fixed two-class synthetic suite; separate from the archived-copy protocol. -->
    <instrumentation
        android:name="com.infomaniak.drive.data.sync.synthetic.SyntheticPhotoInstrumentation"
        android:targetPackage="com.infomaniak.drive.test"
        android:functionalTest="false"
        android:handleProfiling="false" />
    <!-- Genuine schema-7 migration, empty test application and synthetic-only filesystem. -->
    <instrumentation
        android:name="com.infomaniak.drive.data.sync.UploadMigrationInstrumentation"
        android:targetPackage="com.infomaniak.drive.test"
        android:functionalTest="false"
        android:handleProfiling="false" />
</manifest>
